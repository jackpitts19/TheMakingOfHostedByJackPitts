# Security headers for static asset responses (Workers static assets).
# This file is parsed by Cloudflare and is not itself served.
# No Content-Security-Policy on purpose: inline scripts and the Apple/Spotify
# embeds would break without careful tuning.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
